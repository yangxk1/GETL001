<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} %-5p %c{1} - %m%n"/>
    </Console>
  </Appenders>

  <Loggers>
    <!-- 尝试屏蔽 Amazon Neptune 相关库的日志输出 -->
    <Logger name="software.amazon.neptune" level="OFF" additivity="false" />
    <Logger name="amazon.neptune" level="OFF" additivity="false" />
    <Logger name="com.amazon.neptune" level="OFF" additivity="false" />
    <Logger name="com.amazonaws" level="ERROR" additivity="false" />

    <!-- 默认为 ERROR，避免噪音 -->
    <Root level="ERROR">
      <AppenderRef ref="Console" />
    </Root>
  </Loggers>
</Configuration>


@prefix ex: <http://example.org/\> .
@prefix foaf: <http://xmlns.com/foaf/0.1/\> .
# This is a comment about Alice
ex:alice a foaf:Person ;
    foaf:name "Alice" ;
    foaf:age 30 .
# Another person
ex:bob a foaf:Person ;
    foaf:name "Bob" ;
    foaf:knows ex:alice .
# Resource with literal
ex:resource1 foaf:title "This has a symbol" ;
    foaf:description 'Single quoted string' .
